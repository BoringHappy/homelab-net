# ============================================================
# Unified Container Network - 环境变量示例
#
# 使用方法：
#   cp .env.example .env
#   然后填写下面的认证信息（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# ---------- 构建 ----------
# 基础镜像仓库，默认 docker.io；国内网络可换成可用的镜像源
# （例如 docker.m.daocloud.io）或你自己的私有仓库地址
REGISTRY=docker.io

# ---------- Tailscale ----------
# 认证密钥（Auth Key）：https://login.tailscale.com/admin/settings/keys
# 建议使用可复用（reusable）密钥；节点身份会持久化在 ts-state 卷中
TS_AUTHKEY=

# 自定义控制服务器（可选，默认空 = 官方控制平面）
# 使用 Headscale 等自建控制服务器时填写，例如：https://headscale.example.com
TS_AUTH_SERVER=

# 节点名（可选，默认取容器 hostname）
TS_HOSTNAME=unified-net

# tailscale up 附加参数（可选）
# 例：--advertise-routes=192.168.1.0/24 --ssh
TS_EXTRA_ARGS=

# ---------- Cloudflare Mesh (Cloudflare One Client) ----------
# Mesh 节点 Token：Cloudflare 控制台 -> Networking -> Mesh -> Add a node
# 节点注册状态会持久化在 warp-state 卷中
MESH_NODE_TOKEN=

# ---------- 服务选择 ----------
# 逗号分隔，可选：mihomo / tailscale / mesh
# 默认全部启动；例：SERVICES=mihomo,tailscale 只启动代理和 tailscale
SERVICES=mihomo,tailscale,mesh

# ---------- Chromium 示例容器 ----------
# Chromium Web 界面映射到宿主机的端口（默认 18000；容器内固定监听 3000）
CHROMIUM_PORT=18000

# ---------- 局域网固定 IP（macvlan / ipvlan 模式使用） ----------
# 宿主机网卡名可能随机器/网卡变化，这里集中配置，换机器只改 .env
# host-ip / host 模式不需要这四个变量
MACVLAN_PARENT=enp3s0
MACVLAN_SUBNET=192.168.5.0/24
MACVLAN_GATEWAY=192.168.5.1
# 容器固定 IP（建议选主路由 DHCP 分配范围之外的地址，避免冲突）
NET_IP=192.168.5.50

# ---------- 通用 ----------
# 时区，例如 Asia/Shanghai
TZ=UTC
