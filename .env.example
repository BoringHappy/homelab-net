# ============================================================
# Unified Container Network - 环境变量示例
#
# 使用方法：
#   cp .env.example .env
#   然后填写下面的认证信息（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# ---------- Tailscale ----------
# 认证密钥（Auth Key）：https://login.tailscale.com/admin/settings/keys
# 建议使用可复用（reusable）密钥；节点身份会持久化在 ts-state 卷中
TS_AUTHKEY=

# 节点名（可选，默认取容器 hostname）
TS_HOSTNAME=unified-net

# tailscale up 附加参数（可选）
# 例：--advertise-routes=192.168.1.0/24 --ssh
TS_EXTRA_ARGS=

# ---------- Cloudflare Tunnel ----------
# 隧道 Token：Cloudflare Zero Trust -> Networks -> Tunnels -> 创建隧道后复制
# 使用 token 时无需再配置 TUNNEL_ID / TUNNEL_CRED_FILE
TUNNEL_TOKEN=

# 或者改用凭据文件方式（与 TUNNEL_TOKEN 二选一，token 优先）：
# TUNNEL_ID=<tunnel-id>
# TUNNEL_CRED_FILE=/etc/cloudflared/<tunnel-id>.json

# ---------- Cloudflare Mesh (Cloudflare One Client) ----------
# Mesh 节点 Token：Cloudflare 控制台 -> Networking -> Mesh -> Add a node
# 节点注册状态会持久化在 warp-state 卷中
MESH_NODE_TOKEN=

# ---------- 服务选择 ----------
# 逗号分隔，可选：mihomo / tailscale / mesh / cloudflared
# 默认全部启动；例：SERVICES=mihomo,tailscale 只启动代理和 tailscale
SERVICES=mihomo,tailscale,mesh,cloudflared

# ---------- 通用 ----------
# 时区，例如 Asia/Shanghai
TZ=UTC
