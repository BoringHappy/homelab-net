#!/bin/sh
# 等待 warp-svc 就绪
i=0
while ! warp-cli --accept-tos status >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -ge 30 ] && break
    sleep 1
done

if [ -z "${MESH_NODE_TOKEN:-}" ]; then
    echo "[mesh] MESH_NODE_TOKEN 未设置，跳过 Mesh 注册"
    exit 0
fi

if [ -f /var/lib/cloudflare-warp/reg.json ]; then
    echo "[mesh] 已注册，跳过"
else
    echo "[mesh] 使用 MESH_NODE_TOKEN 注册 Mesh 节点"
    warp-cli --accept-tos connector new "${MESH_NODE_TOKEN}" \
        || { echo "[mesh] 注册失败，请查看 warp 日志"; exit 0; }
fi

warp-cli --accept-tos connect || echo "[mesh] connect 失败，稍后检查 warp-cli status"
exit 0
